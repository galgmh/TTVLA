# 字节码 / 环境 / 构建产物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# 生成数据集与输出：datasets/ 下不入库——唯一例外 datasets/README.md（数据卡）；
# data*/ 兜底覆盖将来的临时输出目录（data_smoke/ 等）
data*/
!datasets/
datasets/*
!datasets/README.md
*.hdf5
*.npz

# 视频默认不入库（生成物 / 一次性实验产物）；
# docs/figures/ 的交付视频例外——docs/status.md 直接引用它们
*.mp4
!docs/figures/*.mp4

logs/
